# Ollama Local Model Configuration
OLLAMA_MODEL=deepseek-r1:1.5b  # The local model you want to use
OLLAMA_BASE_URL=http://localhost:11434  # Default Ollama API endpoint

# Model Parameters
TEMPERATURE=0.7  # Controls creativity/randomness (0.0 - 1.0)
TOP_P=0.9  # Controls diversity of word selection
MAX_TOKENS=2048  # Maximum number of tokens to generate

# Application Settings
DEBUG=False  # Set to True for debugging output
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
